!evaluation/results/summary.json
!evaluation/results/case_results.csv
!evaluation/results/metrics.json
!evaluation/results/failure_analysis.md
!evaluation/results/report.md

# Logs and temporary outputs
*.log
logs/
tmp/
temp/
*.tmp
*.bak
.coverage
htmlcov/

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
