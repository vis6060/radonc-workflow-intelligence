# Python environments, bytecode, and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials*
aws_credentials*

# Patient-level, raw, generated, and restricted data
data/**
!data/README.md
!data/sample/
!data/sample/.gitkeep
**/RADCURE*/
**/*radcure*.csv
**/*radcure*.parquet
**/*patient_level*
**/*patient-level*
generated_data/
restricted/
restricted_data/

# Evaluation outputs (results must be reviewed before inclusion)
evaluation/results/**
